@page "/settings"
@using AlbionCompanion.Gathering
@using AlbionCompanion.Gathering.LiveEvents
@inject IServiceStatusProvider ServiceStatusProvider
@inject LiveEventPipeClient PipeClient
@implements IDisposable

<h1 style="font-size: 24px; margin-bottom: 4px;">Settings</h1>

<div class="ac-card" style="margin-bottom: var(--ac-space-4);">
    <h2>Sniffer service</h2>
    <p>Status: <strong>@_serviceStatus</strong></p>
    @if (_serviceStatus == ServiceStatus.Stopped)
    {
        <button class="ac-button" @onclick="StartServiceAsync" disabled="@_starting">Start service</button>
    }
    else if (_serviceStatus == ServiceStatus.Pending)
    {
        <p class="ac-subtitle">Service is starting...</p>
    }
    else if (_serviceStatus == ServiceStatus.NotInstalled)
    {
        <p class="ac-subtitle">Service is not installed - run installer.exe.</p>
    }
</div>

<div class="ac-card">
    <h2>Live connection</h2>
    <p>Status: <strong>@PipeClient.Status</strong></p>
</div>

@code {
    private ServiceStatus _serviceStatus = ServiceStatus.Stopped;
    private bool _starting;
    private Timer? _pollTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync();
        _pollTimer = new Timer(TimerCallback, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        PipeClient.OnStatusChanged += OnPipeStatusChanged;
    }

    // Timer's callback runs on a thread-pool thread with no caller to observe a faulted Task - an
    // async-void-shaped lambda here would turn any exception inside RefreshStatusAsync into an
    // unhandled exception that can crash the whole process. Swallow and log-free-drop it instead;
    // the next tick just tries again.
    private void TimerCallback(object? state)
    {
        _ = RefreshStatusSafeAsync();
    }

    private async Task RefreshStatusSafeAsync()
    {
        try
        {
            await RefreshStatusAsync();
        }
        catch
        {
            // Transient failure (e.g. the component is mid-disposal) must never crash the process
            // from a timer callback - the next tick will simply retry.
        }
    }

    private async Task RefreshStatusAsync()
    {
        _serviceStatus = await ServiceStatusProvider.GetStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartServiceAsync()
    {
        _starting = true;
        try
        {
            await ServiceStatusProvider.StartAsync();
            await RefreshStatusAsync();
            _ = PipeClient.RetryNowAsync();
        }
        finally
        {
            _starting = false;
        }
    }

    private void OnPipeStatusChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _pollTimer?.Dispose();
        PipeClient.OnStatusChanged -= OnPipeStatusChanged;
    }
}
