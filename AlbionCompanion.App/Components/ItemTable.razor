@* Filterable/sortable/paginated table of gathered items. Client-side (item counts per session
   are small - dozens of distinct tier/category/enchantment combos at most, never worth a DB round
   trip). Display names are looked up in bulk from IItemDictionaryService (ao-bin-dumps items.json,
   seeded at startup) instead of showing raw ids like "T4_ORE". *@
@using AlbionCompanion.Core.Models
@using AlbionCompanion.Gathering
@inject IItemDictionaryService ItemDictionary

<div style="display:flex; align-items:center; justify-content:space-between; gap: var(--ac-space-3); margin-bottom: var(--ac-space-3);">
    <div class="ac-section-label" style="margin-bottom:0;">@Title</div>
    <input class="ac-input" style="min-width:160px;" type="text" placeholder="Filter items..." value="@_filter" @oninput="OnFilterInput" />
</div>

@{
    var rows = FilteredSorted();
}

@if (rows.Count == 0)
{
    <p class="ac-subtitle">No items match "@_filter".</p>
}
else
{
    <table class="ac-table">
        <thead>
            <tr>
                <th><button class="ac-sort-btn" @onclick="() => SetSort(SortColumn.Item)">Item @SortIndicator(SortColumn.Item)</button></th>
                <th><button class="ac-sort-btn" @onclick="() => SetSort(SortColumn.Tier)">Tier @SortIndicator(SortColumn.Tier)</button></th>
                <th><button class="ac-sort-btn" @onclick="() => SetSort(SortColumn.Enchantment)">Enchant @SortIndicator(SortColumn.Enchantment)</button></th>
                <th class="ac-num"><button class="ac-sort-btn" @onclick="() => SetSort(SortColumn.Amount)">Amount @SortIndicator(SortColumn.Amount)</button></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (itemId, amount) in rows.Skip((_page - 1) * PageSize).Take(PageSize))
            {
                <ItemRow ItemId="@itemId" Amount="@amount" DisplayName="@ResolveDisplayName(itemId)" />
            }
        </tbody>
    </table>

    var totalPages = Math.Max(1, (int)Math.Ceiling(rows.Count / (double)PageSize));
    @if (totalPages > 1)
    {
        <div class="ac-pager">
            <button class="ac-pager-btn" disabled="@(_page <= 1)" @onclick="() => _page--">Prev</button>
            <span class="ac-subtitle" style="margin:0;">Page @_page of @totalPages</span>
            <button class="ac-pager-btn" disabled="@(_page >= totalPages)" @onclick="() => _page++">Next</button>
        </div>
    }
}

@code {
    private enum SortColumn { Item, Tier, Enchantment, Amount }

    [Parameter, EditorRequired]
    public IReadOnlyDictionary<string, int> Items { get; set; } = new Dictionary<string, int>();

    [Parameter]
    public string Title { get; set; } = "Items";

    private const int PageSize = 15;

    private string _filter = string.Empty;
    private SortColumn _sortBy = SortColumn.Amount;
    private bool _sortDescending = true;
    private int _page = 1;
    private IReadOnlyDictionary<string, ItemDictionary> _displayNames = new Dictionary<string, ItemDictionary>();
    private IReadOnlyDictionary<string, int>? _lookedUpFor;

    protected override async Task OnParametersSetAsync()
    {
        // Re-resolve only when the underlying item set actually changed (not on every re-render -
        // Home's live table re-renders on every gathering event, most of which don't add a new item).
        if (ReferenceEquals(_lookedUpFor, Items))
        {
            return;
        }

        _displayNames = await ItemDictionary.GetItemsByIdAsync(Items.Keys);
        _lookedUpFor = Items;
    }

    private string ResolveDisplayName(string itemId) =>
        _displayNames.TryGetValue(itemId, out var entry) ? entry.DisplayNameEN : itemId;

    private void OnFilterInput(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? string.Empty;
        _page = 1;
    }

    private void SetSort(SortColumn column)
    {
        if (_sortBy == column)
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortBy = column;
            _sortDescending = true;
        }

        _page = 1;
    }

    private string SortIndicator(SortColumn column) =>
        _sortBy != column ? "" : _sortDescending ? "▾" : "▴";

    private List<KeyValuePair<string, int>> FilteredSorted()
    {
        IEnumerable<KeyValuePair<string, int>> query = Items;
        if (!string.IsNullOrWhiteSpace(_filter))
        {
            query = query.Where(kv =>
                kv.Key.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
                ResolveDisplayName(kv.Key).Contains(_filter, StringComparison.OrdinalIgnoreCase));
        }

        query = _sortBy switch
        {
            SortColumn.Item => _sortDescending ? query.OrderByDescending(kv => ResolveDisplayName(kv.Key)) : query.OrderBy(kv => ResolveDisplayName(kv.Key)),
            SortColumn.Tier => _sortDescending
                ? query.OrderByDescending(kv => ItemDisplay.Parse(kv.Key).Tier ?? -1)
                : query.OrderBy(kv => ItemDisplay.Parse(kv.Key).Tier ?? -1),
            SortColumn.Enchantment => _sortDescending
                ? query.OrderByDescending(kv => ItemDisplay.Parse(kv.Key).EnchantmentLevel)
                : query.OrderBy(kv => ItemDisplay.Parse(kv.Key).EnchantmentLevel),
            _ => _sortDescending ? query.OrderByDescending(kv => kv.Value) : query.OrderBy(kv => kv.Value),
        };

        var list = query.ToList();

        // Guard against the page going stale after a filter shrinks the result set out from under it.
        var totalPages = Math.Max(1, (int)Math.Ceiling(list.Count / (double)PageSize));
        if (_page > totalPages)
        {
            _page = totalPages;
        }

        return list;
    }
}
